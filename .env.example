# Inverted TaskFlow Server - Docker settings. Copy to .env and adjust.
# No secrets belong here: the server reads its own settings from server.ini (TASKFLOW_CONFIG_DIR).

# ---- image
TASKFLOW_IMAGE=inverted/taskflow-server
TASKFLOW_TAG=1.0.1

# ---- network
# Production server name. The desktop apps connect to https://TASKFLOW_HOST:TASKFLOW_PORT
# (production: https://task.inverted.in:8443). The entrypoint refuses to start if the TLS certificate does not
# cover this name, and prints the address and the certificate fingerprint for build_installer.bat.
# It does NOT configure DNS or create a certificate. Local test: TASKFLOW_HOST=localhost
TASKFLOW_HOST=task.inverted.in
# port on the host (the container side is always 8443)
TASKFLOW_PORT=8443
# host address the port is published on: 0.0.0.0 = all interfaces; set the office-network IP to limit it
TASKFLOW_BIND_IP=0.0.0.0

# ---- host folders (absolute paths recommended in production, e.g. /srv/taskflow/...)
# server.ini (read-only in the container, /etc/taskflow/conf)
TASKFLOW_CONFIG_DIR=./taskflow-data/config
# cert.pem + key.pem (read-only in the container, /etc/taskflow/tls)
TASKFLOW_TLS_DIR=./taskflow-data/tls
# database, WAL files, backups, initial_admin_password.txt (writable, /var/lib/taskflow)
TASKFLOW_DATA_DIR=./taskflow-data/data

# ---- runtime user (must own TASKFLOW_DATA_DIR and be able to read key.pem); changing it rebuilds the image
TASKFLOW_UID=10001
TASKFLOW_GID=10001

# ---- time zone for due dates, overdue reminders and the daily backup time
TASKFLOW_TZ=Asia/Kolkata

# ---- resources
TASKFLOW_CPUS=2
TASKFLOW_MEMORY=1g
BUILD_JOBS=2

# ---- safety switches (leave at 0)
# 1 = allow plain HTTP (only behind a TLS reverse proxy that you run yourself)
TASKFLOW_ALLOW_HTTP=0
# 1 = start with an empty database although backups exist (only when you really mean it)
TASKFLOW_ALLOW_NEW_DB=0
