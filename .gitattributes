# keep line endings right whatever core.autocrlf is set to on the build PC
*.sh                text eol=lf
deploy/linux/*      text eol=lf
*.service           text eol=lf
server/config/server.ini.linux text eol=lf
deploy/docker/*     text eol=lf
Dockerfile          text eol=lf
docker-compose.yml  text eol=lf
.env.example        text eol=lf
.dockerignore       text eol=lf
*.bat               text eol=crlf
*.ps1               text eol=crlf
windows/*.ini       text eol=crlf
windows/Caddyfile.example text eol=crlf
*.png  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.exe  binary
