[Unit]
Description=Inverted TaskFlow Server
Documentation=file:///usr/local/share/taskflow/IT_Admin_Guide.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taskflow
Group=taskflow
ExecStart=/opt/taskflow/TaskFlowServer --config /etc/taskflow/server.ini
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0027

# ---- hardening: the service can only write its data and log folders
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadWritePaths=/var/lib/taskflow /var/log/taskflow
ReadOnlyPaths=/etc/taskflow

[Install]
WantedBy=multi-user.target
